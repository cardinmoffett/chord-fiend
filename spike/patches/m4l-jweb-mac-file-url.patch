+
+/**
+ * The file:// URL [jweb] needs for a path from `this.patcher.filepath`.
+ *
+ * On macOS Max reports paths in its own form, with the volume name in front:
+ * `Macintosh HD:/Users/me/Music/...`. Max's File accepts that, so extraction works,
+ * but Chromium does not: `file:///Macintosh%20HD:/Users/...` names nothing, and the
+ * page shows "Your file couldn't be accessed". Seen on Live 12 / Max 9 on a Mac.
+ *
+ * The boot volume's files live at `/`; any other volume is mounted under
+ * `/Volumes/<name>`. Max's path does not say which volume booted, so a path into
+ * the standard top-level folders is taken as the boot volume.
+ *
+ * Windows (`C:/...`) and plain POSIX paths produce exactly the URL they did before.
+ */
+function pageUrl(path: string): string {
+  var m = /^([^\/:]{2,}):\/(.*)$/.exec(path);
+  if (!m) return encodeURI("file:///" + path);
+  var rest = m[2];
+  var onBootVolume = /^(Users|Applications|Library|System|private|opt|Volumes)\//.test(rest);
+  var posix = onBootVolume ? "/" + rest : "/Volumes/" + m[1] + "/" + rest;
+  return encodeURI("file://" + posix);
 }
 
